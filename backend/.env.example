# Async SQLAlchemy connection string (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/bookworm

# Sync connection string used by Alembic migrations
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5433/bookworm

JWT_SECRET=change-this-secret-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# CORS origins, comma separated
CORS_ORIGINS=http://localhost:5173,http://localhost

# Base URL the browser can reach this API at (used to build absolute URLs
# for server-generated placeholder cover art)
PUBLIC_BASE_URL=http://localhost:8000
